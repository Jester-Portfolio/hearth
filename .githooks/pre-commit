#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks is required before committing." >&2
  echo "Install gitleaks and retry. Never bypass this hook for secrets." >&2
  exit 1
fi

# Check exactly the staged changes. Do not scan untracked files.
gitleaks git --staged --redact --exit-code 1
