#!/bin/sh
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks is required before pushing." >&2
  exit 1
fi

# Examine commits being pushed (including history on a first push).
# Full repository history is small today; this favors safety over speed.
gitleaks git --redact --exit-code 1
